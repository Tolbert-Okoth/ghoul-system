DATABASE_URL=postgres://user:password@host:5432/ghoul
# Set DB_SSL=false for a local Postgres without TLS
DB_SSL=true
PYTHON_MICROSERVICE_URL=http://localhost:5000
# Must match BRAIN_SHARED_SECRET in brain-python/.env
BRAIN_SHARED_SECRET=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FRONTEND_URL=http://localhost:3000
PORT=4000
# Optional. Enables POST /api/admin/reset (at least 16 characters). Leave empty to disable.
ADMIN_RESET_KEY=
